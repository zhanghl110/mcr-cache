# =============================================================================
# 【已迁移 2026-11-05】本文件内容已并入 ../EMS-DOTNET10-MCR/Dockerfile（唯一权威定义）。
#   保留此副本仅作历史留档；请勿再按本文件构建，以免出现第二份定义。
# =============================================================================
# Dockerfile.mcr-base —— 官方 aspnet:10.0 + 补齐层，产出与自建基线同形态的镜像
#
# 【权威定义，唯一定义】本文件由 build-mcr-base.yml 通过 actions/checkout 取用，
#   即 Actions 里构建的就是这一份。不要再往 workflow 里内联 Dockerfile，
#   两处定义必然漂移（v1 就是因为 yml 内联版多了 `USER appuser`，而本文件没有，
#   构建才在 `ln -snf /etc/localtime` 处 Permission denied）。
#
# 注意区分三个文件：
#   Dockerfile.base        生产自建基线（debian:13-slim + COPY .dotnet），生产在用，不动
#   Dockerfile.mcr-base    本文件，官方 aspnet 补齐基线（v2）
#   Dockerfile / Dockerfile.mcr   业务镜像（后者是测试变体）
#
# 为什么需要它：官方 aspnet:10.0（Ubuntu noble）不含验证码所需的
#   libfontconfig1 / libfreetype6 / libgssapi-krb5-2 / curl，
# 而内网 apt 源被劫持（Clearsigned file isn't valid, got 'NOSPLIT'），现场装不了。
# 所以在 GitHub Actions runner（有公网 apt）里构建好，整镜像导出，内网只 load。
#
# 关键设计：把官方内置的 `app` 用户改名为 `appuser`（uid/gid 仍 1654），
# 使业务 Dockerfile 里的
#     id -u appuser        -> 命中，跳过 useradd（否则 uid 1654 冲突构建失败）
#     getent group 1654    -> 命中，跳过 groupadd
# 这样业务侧 Dockerfile 只需改 FROM 一行。
#
# 【铁律】本文件必须以 root 结束，不写 USER。
#   自建基线 aspnetcore:10-debian 同样是 root 结尾；Dockerfile 的 USER 跨镜像继承，
#   基线非 root 会让下游每个 RUN 都以 uid 1654 执行，首个失败点是写 /etc/localtime。
#   运行身份由业务 Dockerfile 末尾的 USER appuser 决定。
#
# 手工复现（在可联网且有干净 apt 的 amd64 机器上）：
#   docker build -f Dockerfile.mcr-base -t ems/dotnet-base:10.0-mcr-v2 .
# =============================================================================
FROM mcr.microsoft.com/dotnet/aspnet:10.0

ARG APP_UID=1654
ARG APP_GID=1654

ENV TZ=Asia/Shanghai \
    HOME=/app \
    DOTNET_RUNNING_IN_CONTAINER=true

# 官方 runtime-deps 已装：ca-certificates / libicu74 / libssl3t64 / libstdc++6 / tzdata
# 这里只补缺的：字体链、Kerberos、curl（HTTP 探活用）
RUN set -eux; \
    apt-get update; \
    apt-get install -y --no-install-recommends \
        libfontconfig1 \
        libfreetype6 \
        libgssapi-krb5-2 \
        curl; \
    ln -snf "/usr/share/zoneinfo/${TZ}" /etc/localtime; \
    echo "${TZ}" > /etc/timezone; \
    rm -rf /var/lib/apt/lists/*; \
    mkdir -p /app/DataProtection /app/logs; \
    usermod -l appuser -d /app -s /usr/sbin/nologin app; \
    chown -R "${APP_UID}:${APP_GID}" /app

# 自检：构建期就把问题暴露出来，不要留到生产
RUN set -eux; \
    command -v dotnet; \
    dotnet --list-runtimes | grep -q 'Microsoft.AspNetCore.App 10\.'; \
    ldconfig -p | grep -q libfontconfig; \
    ldconfig -p | grep -q libfreetype; \
    ldconfig -p | grep -q libgssapi_krb5; \
    command -v curl; \
    test -e /usr/share/zoneinfo/Asia/Shanghai; \
    id appuser; \
    getent passwd 1654 | grep -q appuser

LABEL org.opencontainers.image.title="ems-dotnet-base-mcr" \
      org.opencontainers.image.base.name="mcr.microsoft.com/dotnet/aspnet:10.0" \
      org.opencontainers.image.description="官方 aspnet 10.0 + 字体/Kerberos/curl 补齐层" \
      maintainer="Alon"

# 保持 root 收尾（见文件头铁律），不要在这里加 USER。
